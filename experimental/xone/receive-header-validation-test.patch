diff --git a/transport/dongle.c b/transport/dongle.c
index fb5494b..5bd3c78 100644
--- a/transport/dongle.c
+++ b/transport/dongle.c
@@ -846,6 +846,10 @@ static int xone_dongle_process_frame(struct xone_dongle *dongle,
 	if (skb->len < hdr_len || hdr_len < sizeof(*hdr))
 		return 0;
 
+	/* Do not dispatch other stations' traffic to GIP clients. */
+	if (!ether_addr_equal(hdr->addr1, dongle->mt.address))
+		return 0;
+
 	skb_pull(skb, hdr_len);
 	type = le16_to_cpu(hdr->frame_control);
 
@@ -920,16 +924,21 @@ static int xone_dongle_process_message(struct xone_dongle *dongle,
 	info = get_unaligned_le32(skb->data);
 	port = FIELD_GET(MT_RX_FCE_INFO_D_PORT, info);
 
-	/* ignore command reponses */
-	if (FIELD_GET(MT_RX_FCE_INFO_CMD_SEQ, info) == 0x01)
+	/* The command and packet headers reuse bits 16..23. */
+	if (port == MT_CPU_RX_PORT &&
+	    FIELD_GET(MT_RX_FCE_INFO_CMD_SEQ, info) == 0x01)
 		return 0;
 
 	/* remove header + trailer */
 	skb_pull(skb, MT_CMD_HDR_LEN);
 	skb_trim(skb, skb->len - MT_CMD_HDR_LEN);
 
-	if (port == MT_WLAN_PORT)
+	if (port == MT_WLAN_PORT) {
+		/* Only native 802.11 packets contain RXWI + an 802.11 header. */
+		if (!(info & MT_RX_FCE_INFO_80211))
+			return 0;
 		return xone_dongle_process_wlan(dongle, skb);
+	}
 
 	if (port != MT_CPU_RX_PORT)
 		return 0;
diff --git a/transport/mt76_defs.h b/transport/mt76_defs.h
index f5fe65b..5d26506 100644
--- a/transport/mt76_defs.h
+++ b/transport/mt76_defs.h
@@ -687,6 +687,8 @@
 #define MT_TXD_INFO_TYPE GENMASK(31, 30)
 
 #define MT_RX_FCE_INFO_LEN GENMASK(13, 0)
+/* Packet header only; overlaps CMD_SEQ in command headers. */
+#define MT_RX_FCE_INFO_80211 BIT(19)
 #define MT_RX_FCE_INFO_SELF_GEN BIT(15)
 #define MT_RX_FCE_INFO_CMD_SEQ GENMASK(19, 16)
 #define MT_RX_FCE_INFO_EVT_TYPE GENMASK(23, 20)
