 static bool LINUX_JoystickRumbleTriggers(SDL_Joystick *joystick, Uint16 left_rumble, Uint16 right_rumble)
 {
+#ifdef FF_TRIGGER_RUMBLE
+    struct ff_effect *effect = &joystick->hwdata->trigger_effect;
+    struct input_event event = { 0 };
+
+    SDL_AssertJoysticksLocked();
+    if (!joystick->hwdata->ff_trigger_rumble) {
+        return SDL_Unsupported();
+    }
+
+    effect->type = FF_TRIGGER_RUMBLE;
+    effect->replay.length = SDL_MAX_RUMBLE_DURATION_MS;
+    effect->u.trigger_rumble.left_magnitude = left_rumble;
+    effect->u.trigger_rumble.right_magnitude = right_rumble;
+    if (ioctl(joystick->hwdata->fd, EVIOCSFF, effect) < 0) {
+        // Retry only if an existing effect disappeared (e.g. device reset).
+        // Do not leak effect slots on permission or resource errors.
+        if (effect->id < 0 || errno != EINVAL) {
+            return SDL_SetError("Couldn't update trigger rumble effect: %s", strerror(errno));
+        }
+        effect->id = -1;
+        if (ioctl(joystick->hwdata->fd, EVIOCSFF, effect) < 0) {
+            return SDL_SetError("Couldn't allocate trigger rumble effect: %s", strerror(errno));
+        }
+    }
+
+    event.type = EV_FF;
+    event.code = effect->id;
+    event.value = (left_rumble || right_rumble) ? 1 : 0;
+    if (write(joystick->hwdata->fd, &event, sizeof(event)) != sizeof(event)) {
+        return SDL_SetError("Couldn't play trigger rumble effect: %s", strerror(errno));
+    }
+    return true;
+#else
     return SDL_Unsupported();
+#endif
 }
 
